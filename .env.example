# ------------------------------------------------------------------------------
# Banco de dados
# ------------------------------------------------------------------------------
# Usado pelo backend para conectar ao PostgreSQL.
# Ao rodar via Docker Compose, o host "db" é o nome do serviço do banco
# (ver docker-compose.yml) — não altere para "localhost" nesse caso.
POSTGRES_USER=prospecta
POSTGRES_PASSWORD=prospecta
POSTGRES_DB=prospecta
DATABASE_URL=postgresql+psycopg2://prospecta:prospecta@db:5432/prospecta

# ------------------------------------------------------------------------------
# Busca de empresas — Google Places API
# ------------------------------------------------------------------------------
# Obrigatória para a busca por cidade/segmento funcionar (POST /api/companies/search).
# Sem essa chave, a API retorna erro 502 explícito em vez de dados inventados.
# Como obter: console.cloud.google.com -> ative "Places API" -> crie uma API key.
# Custos: o Google cobra por chamada após a cota gratuita mensal; consulte a
# página de preços oficial antes de usar em produção.
GOOGLE_PLACES_API_KEY=

# ------------------------------------------------------------------------------
# Análise de sites — Google PageSpeed Insights API
# ------------------------------------------------------------------------------
# Opcional. Se vazia, o sistema usa automaticamente um fallback local
# (requests + BeautifulSoup) para checar HTTPS, viewport mobile e SEO básico,
# mas sem métricas de performance detalhadas do Lighthouse.
# Como obter: console.cloud.google.com -> ative "PageSpeed Insights API".
GOOGLE_PAGESPEED_API_KEY=

# ------------------------------------------------------------------------------
# Geração de mensagens com IA
# ------------------------------------------------------------------------------
# Escolha o provedor: "claude" ou "openai". Apenas a chave do provedor
# escolhido precisa estar preenchida.
AI_PROVIDER=claude

# Anthropic (Claude) - console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI - platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Identidade da agência (usada nos prompts de geração de mensagem)
# ------------------------------------------------------------------------------
AGENCY_NAME=Sua Agência de Software
AGENCY_PITCH=desenvolvimento de sites, landing pages, sistemas web, apps, automações com IA, integrações com WhatsApp e chatbots

# ------------------------------------------------------------------------------
# CORS — origem permitida do frontend
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend — URL da API que o NAVEGADOR do usuário vai acessar
# ------------------------------------------------------------------------------
# Importante: essa URL é embutida no bundle estático do frontend no momento
# do "docker compose build" (variáveis do Vite são compile-time, não
# runtime). Se você mudar isso depois, precisa rodar
# "docker compose up --build frontend" novamente.
VITE_API_URL=http://localhost:8000
